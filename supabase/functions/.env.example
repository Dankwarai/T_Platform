# Copy to supabase/functions/.env (gitignored, auto-loaded by
# `supabase functions serve`) for local development. For a deployed
# project, set it instead with:
#   npx supabase secrets set --env-file supabase/functions/.env
#
# Get a free test-mode secret key from https://dashboard.paystack.com —
# no business verification needed for test mode. Keys start with sk_test_.
PAYSTACK_SECRET_KEY=sk_test_xxx
